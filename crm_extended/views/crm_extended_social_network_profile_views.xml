<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="crm_social_network_profile_form_view" model="ir.ui.view">
            <field name="name">crm_extended.social.network.profile.form</field>
            <field name="model">crm_extended.social.network.profile</field>
            <field name="arch" type="xml">
                <form>
                    <group>
                        <field name="network_id"/>
                        <field name="url"/>
                    </group>
                </form>
            </field>
        </record>
        <record id="crm_social_network_profile_tree_view" model="ir.ui.view">
            <field name="name">crm_extended.social.network.profile.tree</field>
            <field name="model">crm_extended.social.network.profile</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="icon" widget="image"/>
                    <field name="url"/>
                </tree>
            </field>
        </record>

    </data>
</odoo>