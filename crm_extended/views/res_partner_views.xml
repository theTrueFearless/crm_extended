<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_partner_form_Inherited" model="ir.ui.view">
            <field name="name">res.partner.form.inherited</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="arch" type="xml">
                <xpath expr="//page[@name='internal_notes']" position="after">
                    <page string="Social Networks">
                        <field name="social_network_profile_ids"/>
                    </page>
                </xpath>

                <xpath expr="//field[@name='image_1920']" position='after'>
                    <field name="completed_profile" attrs="{'invisible': 1}"/>
                    <div attrs="{'invisible': [('completed_profile', '=', False)]}">
                        <span class="fa fa-check-circle text-success"
                              attrs="{'invisible': [('completed_profile', '=', False)]}">Profile complete
                        </span>
                    </div>
                </xpath>
            </field>
        </record>

        <record id="view_partner_tree_inherit" model="ir.ui.view">
            <field name="name">res.partner.tree.inherit.social</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_tree"/>
            <field name="arch" type="xml">
                <field name="display_name" position="after">
                    <field name="completed_profile" widget="boolean_button" options="{'terminology': 'profile'}"/>
                </field>
            </field>
        </record>
        <record id="view_partner_kanban_inherit_social" model="ir.ui.view">
            <field name="name">res.partner.kanban.inherit.social</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.res_partner_kanban_view"/>
            <field name="arch" type="xml">
                <xpath expr="//div[contains(@class, 'oe_kanban_details')]" position="inside">
                    <field name="completed_profile" attrs="{'invisible': 1}"/>
                    <div t-if="record.completed_profile.raw_value" class="o_kanban_badge text-success">
                        <i class="fa fa-check-circle"/>
                        Profile complete
                    </div>
                </xpath>
            </field>
        </record>

        <record id="view_res_partner_filter_inherit_social" model="ir.ui.view">
            <field name="name">res.partner.search.inherit.social</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_res_partner_filter"/>
            <field name="arch" type="xml">
                <xpath expr="//separator[last()]" position="after">
                    <separator/>

                    <filter string="Profile Complete"
                            name="profile_complete"
                            domain="[('completed_profile','=',True)]"/>

                    <filter string="Profile Incomplete"
                            name="profile_incomplete"
                            domain="[('completed_profile','=',False)]"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>