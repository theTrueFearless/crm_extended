<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="crm_social_network_form_view" model="ir.ui.view">
            <field name="name">crm_extended.social.network.form</field>
            <field name="model">crm_extended.social.network</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="icon" widget="image" />
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="crm_social_network_tree_view" model="ir.ui.view">
            <field name="name">crm_extended.social.network.tree</field>
            <field name="model">crm_extended.social.network</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                    <field name="icon" widget="image" options="{'preview_image': 'icon'}"/>
                </tree>
            </field>
        </record>
        <record id="crm_social_network_action" model="ir.actions.act_window">
            <field name="name">Social Networks</field>
            <field name="res_model">crm_extended.social.network</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p>
                    Create the social media platforms that can be linked to customers.
                </p>
            </field>
        </record>

    </data>
</odoo>